generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  rollNumber   String?       @unique // e.g. "23BBCCED009", "24BBCCCD099"
  role         String        @default("STUDENT") // ADMIN, FACULTY, STUDENT
  department   String?
  semester     Int?          // For students: 1-8
  batch        String?       // Year e.g. "2024-27"
  section      String?       // Batch number e.g. "1", "2" (displayed as "Batch 1")
  campusId     String?       // Numeric ID e.g. "29849", "30824"
  image        String?       // URL
  // Brute-force throttling. Reset to 0 on any successful sign-in.
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  passwordResetTokens PasswordResetToken[]

  subjects     Subject[]     @relation("FacultySubjects")
  quizzes      Quiz[]        @relation("FacultyQuizzes")
  attempts     QuizAttempt[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "CS101"
  name        String            // e.g., "Data Structures"
  semester    Int               // 1-8
  department  String   @default("Computer Science")
  isApproved  Boolean  @default(false) // Requires admin approval
  createdAt   DateTime @default(now())

  faculty     User[]   @relation("FacultySubjects")
  quizzes     Quiz[]
}

model Quiz {
  id                String        @id @default(cuid())
  title             String
  description       String?
  assignedBatches   Json?         // Array of allowed batches e.g. ["2024-28", "2023-27"]
  targetSection     String?       // Batch number restriction e.g. "1", "2"
  targetSemester    Int?          // Semester restriction e.g. 3 (null = all semesters)
  timePerQuestion   Int           @default(30)
  totalQuestions    Int           @default(10)

  enforcementMode   String        @default("NORMAL") // NORMAL, STRICT
  timingMode        String        @default("PER_QUESTION") // PER_QUESTION, TOTAL_DURATION, NO_TIME_LIMIT
  totalDuration     Int?          // In minutes, for TOTAL_DURATION mode
  availableFrom     DateTime?
  availableUntil    DateTime?
  showScore         Boolean       @default(true)
  showAnswers       Boolean       @default(false)
  isPublished       Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  facultyId         String
  faculty           User          @relation("FacultyQuizzes", fields: [facultyId], references: [id])
  subjectId         String
  subject           Subject       @relation(fields: [subjectId], references: [id])
  questions         Question[]
  attempts          QuizAttempt[]
}

model Question {
  id             String   @id @default(cuid())
  text           String
  type           String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, CHECKBOX, SHORT_ANSWER, LONG_ANSWER, DROPDOWN
  options        String   // JSON array of options
  correctIndex   Int      @default(0)
  correctIndices String   @default("[]") // JSON array for checkbox questions
  points         Int      @default(1)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers        Answer[]
}

model QuizAttempt {
  id                       String        @id @default(cuid())
  questionOrder            String
  // JSON object of questionId -> number[] mapping displayed option position
  // back to the question's original option index. Generated server-side the
  // first time a question is served and reused on every later read, so the
  // client never supplies the mapping used for grading.
  shuffleMappings          String        @default("{}")
  currentIndex             Int           @default(0)
  status                   String        @default("IN_PROGRESS")
  score                    Float         @default(0)
  totalPoints              Int           @default(0)
  violationCount           Int           @default(0)
  reloadCount              Int           @default(0)
  // Set when the attempt was submitted past its time budget. Answers arriving
  // late are already rejected at the save path, so this records the fact for
  // faculty rather than changing the score.
  submittedLate            Boolean       @default(false)
  overageSeconds           Int           @default(0)
  timeSpent                Int           @default(0) // Accumulated active seconds on current question/quiz
  startedAt                DateTime      @default(now())
  lastActivityAt           DateTime      @default(now())
  currentQuestionStartTime DateTime      @default(now())
  submittedAt              DateTime?

  studentId       String
  student         User          @relation(fields: [studentId], references: [id])
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id])
  answers         Answer[]
  violations      ViolationLog[]

  @@unique([studentId, quizId])
}

model Answer {
  id              String      @id @default(cuid())
  selectedIndex   Int?        // For single choice
  selectedIndices String?     // JSON array for multiple choice (checkbox)
  textAnswer      String?     // For short/long answer
  isCorrect       Boolean     @default(false)
  timeTaken       Int         @default(0)
  pointsAwarded   Float?      // Null = Not Graded, 0+ = Graded
  feedback        String?     // Optional feedback from faculty
  answeredAt      DateTime    @default(now())

  attemptId       String
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model ViolationLog {
  id          String      @id @default(cuid())
  type        String
  description String?
  occurredAt  DateTime    @default(now())

  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // SHA-256 of the token that was emailed. The plaintext token is never stored,
  // so a database leak cannot be replayed to take over accounts.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PlatformSettings {
  id                      Int      @id @default(1)
  allowedEmailDomains     String   @default("[]")   // JSON string[], empty = allow all
  studentIdLabel          String   @default("Campus ID")
  studentIdFormat         String   @default("ANY")  // NUMERIC, ALPHA, ALPHANUMERIC, ANY
  studentIdMinLength      Int      @default(1)
  studentIdMaxLength      Int      @default(50)
  studentIdRequired       Boolean  @default(false)
  rollNumberLabel         String   @default("Registration Number")
  rollNumberFormat        String   @default("ANY")
  rollNumberMinLength     Int      @default(1)
  rollNumberMaxLength     Int      @default(50)
  rollNumberRequired      Boolean  @default(true)
  maxSemester             Int      @default(8)
  availableBatches        String   @default("[]")   // JSON string[], empty = free-text input
  maxBatchNumber          Int      @default(13)
  enableYearTargeting     Boolean  @default(true)
  enableSemesterTargeting Boolean  @default(true)
  enableBatchTargeting    Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
